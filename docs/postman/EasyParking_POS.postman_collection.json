    },
    {
      "name": "5. Кассын ээлж",
      "item": [
        {
          "name": "Одоогийн ээлж",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/cashier/shift/current",
              "host": [
                "{{base_url}}"
